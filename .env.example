# Claude API (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# OBD-II Adapter (optional — auto-detected if not set)
# Linux default: /dev/ttyUSB0
# macOS default: /dev/cu.usbserial-XXXXXXXX
# Windows default: COM3 (check Device Manager)
OBD_PORT=
OBD_BAUDRATE=
# OBD protocol — set this to skip slow auto-detection (~30s)
# 6 = ISO 15765-4 CAN 11/500 (most 2008+ cars, confirmed working)
# Leave blank to auto-detect (slower but works on any car)
OBD_PROTOCOL=

# Database for recorded sessions, maintenance events, and prediction results
# (optional — defaults to data/sessions.db)
DB_PATH=data/sessions.db

# Anonymized history export salt (optional)
# Change this before sharing exports if you want vehicle keys to differ per install
# or export batch. This controls hash stability; it is not encryption.
OPEN_MECHANIC_EXPORT_SALT=open-mechanic-local-export
